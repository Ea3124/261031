#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
export GIT_OPTIONAL_LOCKS=0
fail() {
    printf 'Commit blocked: %s\nRun ./scripts/check, then stage code and current evidence together.\n' "$1" >&2
    exit 1
}

run=$(cat .evidence/latest 2>/dev/null) || fail 'verification evidence is missing.'
[[ "$run" =~ ^run-[A-Za-z0-9_-]+$ ]] || fail 'invalid evidence pointer.'
staged_run=$(git show :.evidence/latest 2>/dev/null) || fail 'stage .evidence/latest.'
[ "$run" = "$staged_run" ] || fail 'the latest run is not staged.'
directory=".evidence/$run"
receipt=$(git show ":$directory/result" 2>/dev/null) || fail 'stage the latest receipt.'
git cat-file -e ":$directory/output.log" 2>/dev/null || fail 'stage the latest output.log.'
index=$(git rev-parse --git-path index)
temporary=$(mktemp -d "${TMPDIR:-/tmp}/verification-evidence.XXXXXXXX")
trap 'rm -rf "$temporary"' EXIT
cp "$index" "$temporary/index"
export GIT_INDEX_FILE="$temporary/index"
for flag in --no-assume-unchanged --no-skip-worktree; do
    git ls-files -z -- .evidence/latest "$directory" | git update-index "$flag" -z --stdin
done
git diff --quiet -- .evidence/latest "$directory" || fail 'current evidence has unstaged changes.'
[ -z "$(git ls-files --others -- "$directory")" ] || fail 'current evidence has untracked files.'
export GIT_INDEX_FILE="$index"
[ "$(printf '%s\n' "$receipt" | sed -n 's/^status=//p')" = PASS ] || fail 'the latest verification failed.'
[ "$(printf '%s\n' "$receipt" | sed -n 's/^exit_code=//p')" = 0 ] || fail 'the latest exit code is not zero.'
[ "$(printf '%s\n' "$receipt" | sed -n 's/^command=//p')" = ./verification/check ] || fail 'unexpected verification command.'
tree=$(printf '%s\n' "$receipt" | sed -n 's/^tree=//p')
working=$(./scripts/source-tree working)
staged=$(./scripts/source-tree staged)
[ "$working" = "$staged" ] || fail 'stage all current source and documentation.'
[ "$staged" = "$tree" ] || fail 'the staged source differs from the verified tree.'
