diff --git a/README.md b/README.md
new file mode 100644
index 0000000..e39e535
--- /dev/null
+++ b/README.md
@@ -0,0 +1,8 @@
+# CSV 주문 집계 합성 예제
+Python 3.9 이상, POSIX, Git만 사용한다. 프로젝트 루트에서 `python3 app/orders.py input.csv output.json`으로 실행한다. 입력은 UTF-8 CSV의 order_id,amount,status 3개 컬럼이다. amount는 음수 아닌 정수이며 status는 confirmed 또는 cancelled다.
+
+정상 예: a,100,confirmed를 두 번, b,40,cancelled 한 번, c,25,confirmed 한 번 쓰면 출력은 `{"confirmed_count":2,"total_amount":125}` 뒤 LF다. 같은 주문은 한 번 집계하고 충돌·잘못된 행은 기존 출력을 보존한다.
+
+키트를 설치한 프로젝트에서는 `python3 kit.py doctor`, `python3 kit.py map check`, `python3 kit.py check` 순서로 실행한다. 독립 실행은 `mkdir -p /private/tmp/csv-example-run`, `KIT_RUN_DIR=/private/tmp/csv-example-run PYTHONDONTWRITEBYTECODE=1 python3 verification/business.py`, `KIT_RUN_DIR=/private/tmp/csv-example-run python3 verification/runtime.py`, `KIT_RUN_DIR=/private/tmp/csv-example-run python3 verification/cleanup.py` 순서다. 같은 실행 폴더를 재사용하지 말고 새 폴더로 바꾼다. 정적 검사는 `python3 verification/static.py`다.
+
+정책·한계는 work/decisions.tsv, 실제 인계는 work/handoff.md, 기능별 실행 경로는 .agents/skills/verify-app/features/를 확인한다. 보존한 evidence는 합성 데이터만 포함한다. 전체 vendor나 개인 환경, .git은 예제 내보내기에 포함하지 않는다.
diff --git a/app/orders.py b/app/orders.py
new file mode 100644
index 0000000..c2bc4e3
--- /dev/null
+++ b/app/orders.py
@@ -0,0 +1,65 @@
+import argparse
+import csv
+import json
+import os
+from pathlib import Path
+import re
+import sys
+import tempfile
+
+
+def aggregate(stream):
+    reader = csv.DictReader(stream, strict=True)
+    if reader.fieldnames is None or len(reader.fieldnames) != 3 or set(reader.fieldnames) != {"order_id", "amount", "status"}:
+        raise ValueError("필수 컬럼 order_id, amount, status가 정확히 필요합니다")
+    seen = {}
+    count = total = 0
+    for line, row in enumerate(reader, 2):
+        if None in row or any(value is None for value in row.values()):
+            raise ValueError(f"{line}행: 컬럼 수 오류")
+        order_id, raw_amount, status = row["order_id"], row["amount"], row["status"]
+        if not order_id.strip() or not re.fullmatch(r"[0-9]+", raw_amount) or status not in {"confirmed", "cancelled"}:
+            raise ValueError(f"{line}행: 주문 ID, 금액 또는 상태 오류")
+        amount = int(raw_amount)
+        record = (amount, status)
+        if order_id in seen:
+            if seen[order_id] != record:
+                raise ValueError(f"{line}행: 같은 ID의 금액 또는 상태 충돌")
+            continue
+        seen[order_id] = record
+        if status == "confirmed":
+            count += 1
+            total += amount
+    return {"confirmed_count": count, "total_amount": total}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description="CSV 확정 주문 집계")
+    parser.add_argument("input", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args(argv)
+    temp = None
+    try:
+        if args.input.resolve() == args.output.resolve():
+            raise ValueError("입력과 출력 경로가 같을 수 없습니다")
+        with args.input.open(encoding="utf-8", newline="") as stream:
+            result = aggregate(stream)
+        data = (json.dumps(result, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
+        with tempfile.NamedTemporaryFile(dir=args.output.parent, prefix=".orders-", delete=False) as stream:
+            temp = Path(stream.name)
+            stream.write(data)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temp, args.output)
+        temp = None
+        return 0
+    except (OSError, ValueError, csv.Error) as exc:
+        print(f"오류: {exc}", file=sys.stderr)
+        return 1
+    finally:
+        if temp is not None:
+            temp.unlink(missing_ok=True)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/verification/business.py b/verification/business.py
new file mode 100644
index 0000000..7826b9f
--- /dev/null
+++ b/verification/business.py
@@ -0,0 +1,31 @@
+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+spec = importlib.util.spec_from_file_location("orders", "app/orders.py")
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+header = "order_id,amount,status\n"
+cases = [
+    ("fixed", "a,100,confirmed\na,100,confirmed\nb,40,cancelled\nc,25,confirmed\n", {"confirmed_count": 2, "total_amount": 125}),
+    ("empty", "", {"confirmed_count": 0, "total_amount": 0}),
+    ("zero", "a,0,confirmed\na,0,confirmed\nb,9,cancelled\n", {"confirmed_count": 1, "total_amount": 0}),
+    ("conflict-amount", "a,1,confirmed\na,2,confirmed\n", None),
+    ("conflict-status", "a,1,confirmed\na,1,cancelled\n", None),
+    ("negative", "a,-1,confirmed\n", None),
+    ("nonnumeric", "a,hello,confirmed\n", None),
+    ("unknown", "a,1,pending\n", None),
+]
+records=[]
+try:
+    for name, body, expected in cases:
+        try:
+            actual=module.aggregate(io.StringIO(header+body))
+        except ValueError:
+            actual=None
+        records.append({"case": name, "expected": expected, "actual": actual})
+        assert actual == expected, records[-1]
+    print("독립 기대값 기반 불변식 8종 통과")
+finally:
+    Path(os.environ["KIT_RUN_DIR"], "business.json").write_text(json.dumps(records,ensure_ascii=False,indent=2))
diff --git a/verification/cleanup.py b/verification/cleanup.py
new file mode 100644
index 0000000..367d92f
--- /dev/null
+++ b/verification/cleanup.py
@@ -0,0 +1,13 @@
+import json
+import os
+from pathlib import Path
+import shutil
+run=Path(os.environ["KIT_RUN_DIR"])
+scratch=run/"csv-scratch"
+existed=scratch.exists()
+if existed:
+    shutil.rmtree(scratch)
+assert not scratch.exists()
+files=sorted(str(p.relative_to(run)) for p in (run/"csv-evidence").glob("*"))
+(run/"cleanup.json").write_text(json.dumps({"scratch_existed":existed,"scratch_removed":True,"evidence_files":files},ensure_ascii=False,indent=2))
+print(f"자체 임시 상태 정리, 증거 {len(files)}개 보존")
